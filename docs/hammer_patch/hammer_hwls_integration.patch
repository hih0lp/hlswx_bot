             "network": network,
         },
     )
+
+
+# ---------------------------------------------------------------------------
+# Правка и закрытие уже опубликованных постов по запросу HLSWX.
+#
+# Пост в группе отправлен ботом Hammer/W, а Telegram разрешает боту править
+# только свои сообщения. Поэтому кнопки «Редактировать» и «Закрыть» в основном
+# боте не могут изменить пост сами — они просят сделать это нас.
+# ---------------------------------------------------------------------------
+
+
+class HwlsEditPayload(BaseModel):
+    telegram_chat_id: int
+    message_id: int
+    text: str
+    contact: str = ""
+    network: str = "hammer"
+
+
+async def _rerender_and_edit(payload: HwlsEditPayload, *, strike: bool) -> tuple[bool, str]:
+    """Перерисовать пост тем же шаблоном и заменить сообщение в группе."""
+    from aiogram.exceptions import TelegramBadRequest
+
+    from app.bot.runtime import get_bot_for_telegram_id
+    from app.services.hwls_relay import bot_telegram_id_for_network, resolve_hammer_chat
+    from app.services.publisher import render_ad_publication
+
+    network = (payload.network or "hammer").lower()
+    try:
+        bot = await get_bot_for_telegram_id(bot_telegram_id_for_network(network))
+    except Exception as exc:
+        return False, f"bot_unavailable: {str(exc)[:120]}"
+
+    async with SessionLocal() as session:
+        chat = await resolve_hammer_chat(
+            session,
+            telegram_chat_id=int(payload.telegram_chat_id),
+            network=network,
+            telegram_username="",
+            city_key="",
+            bot=bot,
+        )
+        if not chat:
+            return False, "chat_not_found"
+
+        me = await bot.get_me()
+        ad_text = payload.text.strip()
+        if strike:
+            # Закрытое объявление остаётся на месте, но зачёркнуто —
+            # так же, как это делает основной бот со своими постами.
+            ad_text = f"<s>{ad_text}</s>"
+        body, markup = await render_ad_publication(
+            session,
+            ad_text,
+            payload.contact.strip(),
+            chat=chat,
+            vip=False,
+            premium=False,
+            bot_username=me.username,
+            ref_payload=None,
+        )
+
+    chat_id = int(payload.telegram_chat_id)
+    message_id = int(payload.message_id)
+    try:
+        await bot.edit_message_text(
+            text=body, chat_id=chat_id, message_id=message_id, reply_markup=markup,
+        )
+    except TelegramBadRequest as exc:
+        err = (exc.message or str(exc)).lower()
+        if "message is not modified" in err:
+            return True, ""
+        # Пост с фотографией — у него не текст, а подпись.
+        if "no text in the message" in err or "message to edit not found" not in err:
+            try:
+                await bot.edit_message_caption(
+                    caption=body, chat_id=chat_id, message_id=message_id, reply_markup=markup,
+                )
+                return True, ""
+            except Exception as exc2:
+                return False, str(exc2)[:200]
+        return False, str(exc)[:200]
+    except Exception as exc:
+        return False, str(exc)[:200]
+    return True, ""
+
+
+async def _handle_edit_request(request: Request, *, strike: bool) -> JSONResponse:
+    client_ip = request.client.host if request.client else "unknown"
+    if not check_rate_limit(f"hwls-edit:{client_ip}", max_calls=120):
+        return JSONResponse({"ok": False, "error": "rate_limit"}, status_code=429)
+
+    if not _authorized(request):
+        return JSONResponse({"ok": False, "error": "unauthorized"}, status_code=401)
+
+    try:
+        payload = HwlsEditPayload.model_validate(await request.json())
+    except Exception:
+        return JSONResponse({"ok": False, "error": "invalid_payload"}, status_code=400)
+
+    if not payload.text.strip():
+        return JSONResponse({"ok": False, "error": "text_required"}, status_code=400)
+    if not payload.message_id:
+        return JSONResponse({"ok": False, "error": "message_id_required"}, status_code=400)
+
+    ok, err = await _rerender_and_edit(payload, strike=strike)
+    if not ok:
+        code = 404 if err in ("chat_not_found",) else 502
+        logger.warning(
+            "HWLS %s failed chat=%s msg=%s: %s",
+            "close" if strike else "edit",
+            payload.telegram_chat_id,
+            payload.message_id,
+            err,
+        )
+        return JSONResponse({"ok": False, "error": err}, status_code=code)
+
+    logger.info(
+        "HWLS %s applied chat=%s msg=%s",
+        "close" if strike else "edit",
+        payload.telegram_chat_id,
+        payload.message_id,
+    )
+    return JSONResponse({"ok": True})
+
+
+@router.post("/api/hwls/edit")
+async def hwls_edit(request: Request) -> JSONResponse:
+    """Заменить текст ранее опубликованного объявления."""
+    return await _handle_edit_request(request, strike=False)
+
+
+@router.post("/api/hwls/close")
+async def hwls_close(request: Request) -> JSONResponse:
+    """Пометить объявление закрытым — текст зачёркивается."""
+    return await _handle_edit_request(request, strike=True)
