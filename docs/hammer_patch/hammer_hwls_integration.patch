diff -Nur a/app/services/hwls_notify.py b/app/services/hwls_notify.py
--- a/app/services/hwls_notify.py	1970-01-01 00:00:00.000000000 +0000
+++ b/app/services/hwls_notify.py	2026-09-06 17:26:10.919861217 +0000
@@ -0,0 +1,82 @@
+"""Исходящее уведомление основного бота (HLSWX) о выходе разового поста.
+
+Основной бот ведёт очередь публикаций подписчиков и обязан выдерживать
+20-минутную тишину группы после разового поста. Узнать об этом сам он не
+может: Telegram не отдаёт ботам сообщения, отправленные другими ботами.
+Поэтому факт публикации сообщаем ему явно.
+
+Приём на стороне HLSWX: POST /api/hwls/oneshot-published, авторизация тем же
+заголовком X-HWLS-Key, что и входящий /api/hwls/publish. Запрос идемпотентен
+по message_id — повтор окно тишины не сдвигает, ретраить безопасно.
+"""
+
+from __future__ import annotations
+
+import logging
+from datetime import datetime
+
+import httpx
+
+from app.config import get_settings
+
+logger = logging.getLogger("hwls_notify")
+
+
+async def notify_hwls_oneshot_published(
+    *,
+    telegram_chat_id: int | None,
+    telegram_username: str = "",
+    network: str = "hammer",
+    message_id: int | None = None,
+    published_at: datetime | None = None,
+) -> tuple[bool, str]:
+    """Сообщить HLSWX, что в группе вышел разовый пост.
+
+    Возвращает (успех, причина). Ошибка никогда не должна ломать публикацию —
+    вызывающий код обязан её проглотить: пост уже в группе, и откатывать его
+    из-за недоступности соседнего сервиса нельзя.
+    """
+    settings = get_settings()
+    url = (getattr(settings, "hwls_oneshot_webhook_url", "") or "").strip()
+    if not url:
+        return False, "hwls_notify_disabled"
+
+    secret = (settings.hwls_relay_secret or "").strip()
+    if not secret:
+        return False, "hwls_secret_not_configured"
+
+    if not telegram_chat_id and not telegram_username:
+        return False, "chat_unknown"
+
+    payload = {
+        "telegram_chat_id": telegram_chat_id,
+        "telegram_username": (telegram_username or "").lstrip("@"),
+        "network": (network or "hammer").lower(),
+        "message_id": message_id,
+        "published_at": published_at.isoformat() if published_at else None,
+    }
+    headers = {"X-HWLS-Key": secret, "Content-Type": "application/json"}
+
+    try:
+        async with httpx.AsyncClient(timeout=15.0) as client:
+            resp = await client.post(url, json=payload, headers=headers)
+    except httpx.RequestError as exc:
+        logger.warning("HWLS oneshot notify unreachable chat=%s: %s", telegram_chat_id, exc)
+        return False, f"unreachable: {exc}"
+
+    if resp.status_code >= 400:
+        logger.warning(
+            "HWLS oneshot notify rejected chat=%s: %s %s",
+            telegram_chat_id,
+            resp.status_code,
+            resp.text[:200],
+        )
+        return False, f"http_{resp.status_code}"
+
+    logger.info(
+        "HWLS notified about oneshot post chat=%s msg=%s network=%s",
+        telegram_chat_id,
+        message_id,
+        network,
+    )
+    return True, ""
